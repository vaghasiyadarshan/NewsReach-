{
  "name": "newsreach-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/infrastructure/webserver/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --env-file=../.env src/infrastructure/webserver/main.ts",
    "migrate": "tsx --env-file=../.env src/infrastructure/orm/migrate-cli.ts",
    "seed": "tsx --env-file=../.env src/infrastructure/orm/seed-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
